# Winback AI — Environment Variables
# Copy to .env.local and fill in values. Never commit real values.

# Database (server-only). For Supabase use the Session pooler URI (IPv4):
# Supabase dashboard -> Connect -> Session pooler
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# App
NEXT_PUBLIC_APP_NAME=Winback AI

# Supabase project (public values; reserved for Supabase Auth, not used yet)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI Providers (server-side only — never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite (see ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=
SARVAM_API_KEY=

# Demo mode
DEMO_MODE=true
DEMO_SEED=winback-demo-v1
