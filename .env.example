# Winback AI — Environment Variables
# Copy to .env.local and fill in values

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/winback

# App
NEXT_PUBLIC_APP_NAME=Winback AI

# AI Providers (server-side only — never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=
SARVAM_API_KEY=

# Demo mode
DEMO_MODE=true
DEMO_SEED=winback-demo-v1
